<Page
    x:Class="Lamina.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Lamina.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--  The BEAUTIFUL and Anti-Corporate Onboarding Page ( Btw Alex Brush is W Font for Someone who likes Cursive like me! )  -->

    <Page.Resources>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Page.Resources>

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid>
        <!--  Welcome Slide with Lamina Ã¢Å“Â¦ BIG AND CENTRED  -->
        <Grid x:Name="SlidesContainer">
            <StackPanel
                x:Name="Slide1"
                VerticalAlignment="Center"
                Spacing="40">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="ms-appx:///Assets/Fonts/AlexBrush-Regular.ttf#Alex Brush"
                    FontSize="72"
                    Text="Lamina ✦" />
                <Button
                    Width="120"
                    Height="50"
                    HorizontalAlignment="Center"
                    Click="Next_Click"
                    Content="&#xE72A;"
                    CornerRadius="8"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!--  Customization Page with Everything Ripped from Settings Page (lol)  -->
            <Grid
                x:Name="Slide2"
                Margin="24,40,24,24"
                RowDefinitions="Auto,*"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontFamily="ms-appx:///Assets/Fonts/AlexBrush-Regular.ttf#Alex Brush"
                    FontSize="48"
                    Text="Customise" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Border
                        Width="280"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE790;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Theme" />
                            <ComboBox
                                Grid.Column="2"
                                Width="120"
                                SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border
                        Width="280"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.IsBackdropCardDisabled, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xEB42;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Backdrop" />
                                <ComboBox
                                    Grid.Column="2"
                                    Width="120"
                                    SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Mica Alt" />
                                    <ComboBoxItem Content="Mica" />
                                    <ComboBoxItem Content="Acrylic" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border
                        Width="280"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE78B;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Splash Screen" />
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0,-6,0,-6"
                                IsOn="{x:Bind ViewModel.IsSplashEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border
                        Width="280"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE895;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Check for Updates" />
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0,-6,0,-6"
                                IsOn="{x:Bind ViewModel.IsUpdateCheckEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                <Button
                    Width="120"
                    Height="50"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="Next_Click"
                    Content="&#xE72A;"
                    CornerRadius="8"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>


            </Grid>

            <!--  Have a Nice Time with Lamina Ã¢Å“Â¦ !  -->
            <StackPanel
                x:Name="Slide3"
                VerticalAlignment="Center"
                Spacing="32"
                Visibility="Collapsed">
                <FontIcon
                    FontFamily="/Assets/Fonts/Lamina_Fonts.ttf#Lamina_Fonts"
                    FontSize="100"
                    Foreground="{ThemeResource AccentButtonBackground}"
                    Glyph="&#xE90E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="ms-appx:///Assets/Fonts/AlexBrush-Regular.ttf#Alex Brush"
                    FontSize="40"
                    Text="Have a Nice Time!" />
                <Button
                    Width="120"
                    Height="50"
                    HorizontalAlignment="Center"
                    Click="Finish_Click"
                    Content="&#xE72A;"
                    CornerRadius="8"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>
